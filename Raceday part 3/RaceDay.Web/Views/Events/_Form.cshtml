@model EventFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
<input asp-for="EventID" type="hidden" />
<div class="row g-3">
    <div class="col-md-8"><label asp-for="EventName" class="form-label">Event name</label><input asp-for="EventName" class="form-control" required /><span asp-validation-for="EventName" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="EventType" class="form-label">Event type</label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div>
    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="col-md-6"><label asp-for="EventDate" class="form-label">Date</label><input asp-for="EventDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="StartTime" class="form-label">Start time</label><input asp-for="StartTime" type="time" class="form-control" /></div>
    <div class="col-md-8"><label asp-for="Location" class="form-label">Location</label><input asp-for="Location" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="MaximumParticipants" class="form-label">Maximum participants</label><input asp-for="MaximumParticipants" class="form-control" type="number" min="1" /></div>
    <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option>Open</option><option>Closed</option><option>Completed</option><option>Cancelled</option></select></div>
    <div class="col-12"><label asp-for="Banner" class="form-label">Event banner (JPG, PNG or WebP, max 5 MB)</label><input asp-for="Banner" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" /><span asp-validation-for="Banner" class="text-danger"></span></div>
    @if (!string.IsNullOrEmpty(Model.ExistingBanner)) { <div class="col-12"><img src="@Model.ExistingBanner" alt="Current event banner" class="banner-preview"/></div> }
</div>
<button type="submit" class="btn btn-race mt-4">Save event</button><a asp-action="Index" class="btn btn-outline-secondary mt-4 ms-2">Cancel</a>
