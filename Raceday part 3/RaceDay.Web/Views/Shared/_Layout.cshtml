@{
    var role = Context.Session.GetString("Role");
    var firstName = Context.Session.GetString("FirstName");
    var signedIn = Context.Session.GetInt32("UserID") is not null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#112a37" />
    <title>@ViewData["Title"] | RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark raceday-nav">
        <div class="container">
            <a class="navbar-brand fw-black" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RACEDAY <span class="brand-suffix">/ TRACK YOUR MOMENT</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    @if (role == "Organiser" && signedIn)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Create">Create Event</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                    }
                    else if (role == "Participant" && signedIn)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Explore">Explore Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Enrollments" asp-action="My">My Entries</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="My">My Results</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                    }
                    @if (signedIn)
                    {
                        <li class="nav-item"><span class="nav-link text-light opacity-75">Hi, @firstName</span></li>
                        <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">@Html.AntiForgeryToken()<button class="btn btn-outline-light btn-sm" type="submit">Sign out</button></form></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        <li class="nav-item"><a class="btn btn-race btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <main class="container main-content">
        @if (TempData["Success"] is string success)
        {
            <div role="status" class="alert alert-success mt-3">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div role="alert" class="alert alert-danger mt-3">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>© @DateTime.Now.Year RACEDAY / Built for the finish line.</span>
            <span>RUN · WALK · CYCLE</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
