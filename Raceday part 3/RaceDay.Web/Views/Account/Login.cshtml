@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="auth-shell py-5">
    <div class="auth-aside"><span class="eyebrow">RACEDAY / YOUR ACCOUNT</span><h1>THE NEXT START LINE IS YOURS.</h1><p>From your first 5K to your next event launch, everything happens here.</p><div class="giant-number">GO.</div></div>
    <div class="auth-card"><span class="eyebrow dark">WELCOME BACK</span><h2>Sign in to RaceDay</h2><p class="text-secondary">Enter your details to continue.</p>
        <form asp-action="Login" method="post">@Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control mb-2" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Email" class="text-danger"></span>
            <label asp-for="Password" class="form-label mt-3">Password</label><input asp-for="Password" class="form-control mb-2" autocomplete="current-password"/><span asp-validation-for="Password" class="text-danger"></span>
            <button class="btn btn-race w-100 mt-4" type="submit">Sign in</button>
        </form>
        <p class="mt-4 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
